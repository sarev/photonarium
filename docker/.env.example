# =============================================================================
# Photonarium Docker Configuration
#
# Copy this file to .env and edit to match your setup:
#   cp docker/.env.example docker/.env
# =============================================================================

# -----------------------------------------------------------------------------
# User/Group ID
# -----------------------------------------------------------------------------
# Match your NAS user to avoid permission issues on mounted volumes.
# Find your IDs: id -u (PUID) and id -g (PGID)
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port for the web interface
PHOTONARIUM_PORT=5000

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# Application data (database, thumbnails, models, config)
# IMPORTANT: Must be on LOCAL storage, not NFS/SMB (SQLite doesn't work over network)
# Expect 15-20 GB for a medium-sized library (~65k images)
CONFIG_PATH=./config

# Catalogue directory for imported photos
# Photos are organised into YYYY/YYYY-MM-DD/ folders
CATALOGUE_PATH=./catalogue

# Photo library to index (used with docker-compose.photos.yml overlay)
# Set to your existing photo folder path
# PHOTOS_PATH=/path/to/your/photos

# -----------------------------------------------------------------------------
# Image variant
# -----------------------------------------------------------------------------
# Which image to use (set by the build process)
# Options: latest, cpu, cu118, cu126, cu128, intel
PHOTONARIUM_TAG=latest
